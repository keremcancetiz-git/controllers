[Unit]
Description=Sensor Gateway - Modbus RTU to MQTT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=innoflex
WorkingDirectory=/home/innoflex/sensor-controller
ExecStart=/home/innoflex/.local/bin/uv run main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target